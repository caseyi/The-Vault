<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Allow the app to spawn/load the bundled Node (signed by a different team)
       without macOS library-validation killing or blocking it. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Probably unnecessary: the bundled Node is a separately signed, notarized
       binary and we pass it no DYLD_* variables. Kept because removing it
       can't be verified without a macOS build + Gatekeeper test; drop it in a
       release where that test is done. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
