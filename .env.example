# ── The Vault - configuration ────────────────────────────────────────────────
# Copy this file to `.env` next to docker-compose.yml (`.env` is gitignored):
#
#   cp .env.example .env
#
# Then start (or apply changes) with:  sudo docker compose up -d
# and update later with:               sudo sh update.sh
#
# Values: no quotes needed, spaces are fine. If a value contains `$`, wrap it
# in single quotes: SMB_PASS='pa$word'
# ─────────────────────────────────────────────────────────────────────────────

# ── Claude AI (optional) ──────────────────────────────────────────────────────
# Only needed for the AI features (auto-tagging, image finder, per-model chat).
# Leave blank to run The Vault without AI, or enter a key in the app instead
# (stored in your browser only).
CLAUDE_API_KEY=

# Claude model for AI features. Blank = built-in default (claude-haiku-4-5-20251001).
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Web port ──────────────────────────────────────────────────────────────────
# The Vault UI is served here:  http://<your-nas-ip>:<WEB_PORT>
# (update.sh also reads this to check the app after an update.)
WEB_PORT=8484

# ── Primary library (a folder on THIS machine) ────────────────────────────────
# LIBRARY_HOST_PATH = the real folder on your NAS/host that holds your prints.
# LIBRARY_NAME      = the label it shows up under inside the app.
# Both are also passed to the backend so Organize → "generate script" can
# translate /library/<LIBRARY_NAME>/... back to the real NAS path.
LIBRARY_HOST_PATH=/volume1/STL Archive
LIBRARY_NAME=STL Archive

# Optional: SSH target printed in the header of generated Organize scripts.
# ORGANIZE_SSH_TARGET=casey@dagobah

# ── Which build to run ────────────────────────────────────────────────────────
# `latest` follows main. `sudo sh update.sh sha-1a2b3c4` writes a pinned tag here
# for you; `sudo sh update.sh latest` switches back.
# VAULT_TAG=latest

# ── Time zone and database snapshots ──────────────────────────────────────────
# Time zone for logs and the daily snapshot time (IANA name).
TZ=America/Los_Angeles
# How many daily snapshots (backups/vault-YYYYMMDD.db) to keep.
BACKUP_KEEP=7

# ── Data volume / project name (leave unset unless you moved the folder) ──────
# Your database lives in the Docker volume `<project>_vault_data`, and the
# project name defaults to the name of this folder. If you move/rename the
# folder, set this to the prefix of your existing volume
# (see: sudo docker volume ls | grep vault_data), e.g. for the-vault_vault_data:
# COMPOSE_PROJECT_NAME=the-vault

# ── Advanced (optional) ───────────────────────────────────────────────────────
# Extra browser origins allowed to call the API cross-origin (comma list, `*` =
# allow all). Normal use through the web UI or a reverse proxy needs nothing.
# To use it, also uncomment the ALLOWED_ORIGINS line in docker-compose.yml.
# ALLOWED_ORIGINS=https://vault.example.com

# RAR archives bigger than this (MB) are not opened for render extraction.
# ZIPs are streamed and have no limit unless ZIP_MAX_MB is set (0 = no limit).
# ARCHIVE_MAX_MB=500
# ZIP_MAX_MB=0
# Image files bigger than this (MB) are not copied as thumbnails.
# IMAGE_MAX_MB=50

# ── Thumbnails (docs/thumbnails.md) ──
# Small WebP copies of card images are cached in <IMAGES_DIR>/.thumbs (needs sharp,
# bundled in the image). Cards with no picture get one from inside their zips, or a
# preview rendered from the STL/OBJ/3MF itself.
# THUMBS_NO_SHARP=1             # never load sharp; serve original images
# THUMBS_AUTO=1                 # background cache fill and renders (default on)
# THUMBS_RENDER_AFTER_SCAN=1    # render previews for picture-less cards after each scan
# THUMB_PIPELINE_VERSION=1      # bump to retry every card that has no picture
# INNER_ZIP_MAX_MB=64           # zips inside zips (Google Drive exports) opened to look for pictures

# Library display names: <folder under /library>=<label>, comma separated.
# LIBRARY_LABELS=STL Archive=Dagobah,3dPrint=Endor

# layout (default): group files into works (one card per character, with
# Sculpture/Bust editions and Chitubox/X Pose/... variants) and attribute them
# from <library>/_Meta. legacy: the old one-card-per-folder scanner.
# LAYOUT_MODE=layout

# AI Enrich apply policy: answers at or above ENRICH_AUTO_MIN fill EMPTY fields
# automatically; answers between ENRICH_SUGGEST_MIN and that go to Organize > Review.
# ENRICH_AUTO_MIN=0.8
# ENRICH_SUGGEST_MIN=0.5

# 1 = allow the web scraper to fetch private/LAN addresses (off by default).
# SCRAPER_ALLOW_PRIVATE=0

# ── A second LOCAL folder (optional) ──────────────────────────────────────────
# Uncomment here AND uncomment the matching line in docker-compose.yml.
# (Or use `sh add-library.sh`, which needs no edits.)
# Endor example: mount Endor's 3dPrint share on Dagobah with DSM File Station
# -> Tools -> Mount Remote Folder (read-only is enough), then:
# (mount it in any folder OUTSIDE the STL Archive share)
# LIBRARY2_HOST_PATH=/volume1/Mounts/Endor-3dPrint
# LIBRARY2_NAME=3dPrint
# LIBRARY2_HOST_PATH=/volume1/More Prints
# LIBRARY2_NAME=More Prints

# ── A folder on a REMOTE NAS over SMB / CIFS (optional) ───────────────────────
# On Synology, prefer DSM's File Station → Tools → Mount Remote Folder and add
# the mount point as a local folder (add-library.sh, choice 1).
# Otherwise fill these in, then uncomment the `smb_library` block in
# docker-compose.yml (both the volume line and the volume definition at the
# bottom). Passwords containing a comma are not supported this way.
#
#   SMB_HOST   = the other NAS hostname or IP (no slashes), e.g. 192.168.1.50
#   SMB_SHARE  = the shared folder name on that NAS, e.g. 3dprints
#   SMB_USER   = a user that can read the share
#   SMB_PASS   = that user's password
#   SMB_NAME   = the label it shows up under inside the app
SMB_HOST=192.168.1.50
SMB_SHARE=3dprints
SMB_USER=
SMB_PASS=
SMB_NAME=remote
